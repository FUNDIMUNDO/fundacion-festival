rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1) Perfiles de usuario
    match /users/{userId} {
      // Crear perfil sólo si está autenticado y coincide el UID
      allow create: if request.auth != null
                    && request.auth.uid == userId;
      // Leer y actualizar sólo su propio doc
      allow read, update: if request.auth != null
                          && request.auth.uid == userId;
      // No permitir borrar perfiles
      allow delete: if false;
    }

    // 2) Reglas para Eventos
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete:
        if request.auth != null
        && request.auth.token.admin == true;
    }

    // 3) Reglas para Donaciones
    match /donations/{docId} {
      // Sólo usuarios autenticados pueden crear donaciones
      allow create: if request.auth != null;
      // Cada usuario sólo puede leer sus propias donaciones
      allow read:   if request.auth != null
                  && request.auth.uid == resource.data.userId;
      // No permitir actualizar ni eliminar
      allow update, delete: if false;
    }
    
    // 4) Ningún otro acceso
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
