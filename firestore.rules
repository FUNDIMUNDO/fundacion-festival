rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfiles de usuario
    match /users/{userId} {
      // Crear solo si está autenticado y coincide el UID
      allow create: if request.auth != null
                    && request.auth.uid == userId;
      // Leer y actualizar solo su propio doc
      allow read, update: if request.auth != null
                          && request.auth.uid == userId;
      // No permitir borrado
      allow delete: if false;
    }

    // Reglas para Eventos
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete:
        if request.auth != null
        && request.auth.token.admin == true;
    }

    // Reglas para Donaciones
    match /donations/{docId} {
      // Solo usuarios autenticados pueden crear donaciones
      allow create: if request.auth != null;
      // Cada usuario solo puede leer sus propias donaciones
      allow read:   if request.auth != null
                  && request.auth.uid == resource.data.userId;
      // No permitimos actualizar ni eliminar donaciones
      allow update, delete: if false;
    }

  }
}
